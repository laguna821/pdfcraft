# Maintainer: Achmage (laguna821) <laguna821@users.noreply.github.com>
#
# Achmage PDFCraft for Arch Linux and derivatives (CachyOS, EndeavourOS, Manjaro).
# A binary package: it installs the release tarball built on Ubuntu 22.04 (glibc >= 2.35).
# Generated by .github/workflows/release.yml for each release; `install/install.sh` runs it with
# `makepkg -si`. Native Wayland (Niri, Hyprland, Sway, GNOME, KDE): no FUSE, no XWayland needed.

pkgname=achmage-pdfcraft-bin
_ver=@VERSION@
pkgver=@PKGVER@
pkgrel=1
pkgdesc="Korean-ready open-source PDF editor (PdfCraft fork with Pretendard and Hangul editing)"
arch=('x86_64' 'aarch64')
url="https://github.com/laguna821/pdfcraft"
license=('MIT OR Apache-2.0')
depends=('glibc' 'gcc-libs' 'libxkbcommon' 'wayland' 'vulkan-icd-loader' 'hicolor-icon-theme')
optdepends=(
  'mesa: OpenGL/Vulkan drivers (fallback renderer)'
  'libglvnd: OpenGL fallback renderer'
  'libx11: X11 sessions'
  'xdg-desktop-portal-gnome: native file dialogs on Niri and other wlroots compositors'
  'xdg-desktop-portal-gtk: native file dialogs (alternative portal)'
  'zenity: file dialogs when no portal is running'
  'cups: printing'
  'fcitx5-hangul: Korean input method'
  'ttf-nanum: extra Korean glyphs (Hanja) besides the bundled Pretendard'
)
provides=('achmage-pdfcraft' 'pdfcraft')
conflicts=('achmage-pdfcraft' 'pdfcraft' 'pdfcraft-bin')
options=('!strip' '!debug')
source_x86_64=("https://github.com/laguna821/pdfcraft/releases/download/v${_ver}/achmage-pdfcraft-${_ver}-linux-x86_64.tar.gz")
source_aarch64=("https://github.com/laguna821/pdfcraft/releases/download/v${_ver}/achmage-pdfcraft-${_ver}-linux-aarch64.tar.gz")
sha256sums_x86_64=('@SHA256_X86_64@')
sha256sums_aarch64=('@SHA256_AARCH64@')

package() {
  local dir="achmage-pdfcraft-${_ver}-linux-${CARCH}"
  install -dm755 "${pkgdir}/usr"
  cp -a "${srcdir}/${dir}/." "${pkgdir}/usr/"
  chmod 755 "${pkgdir}/usr/bin/pdfcraft" "${pkgdir}/usr/bin/pdfcraft-cli"
  # A friendly alias for the launcher.
  ln -s pdfcraft "${pkgdir}/usr/bin/achmage-pdfcraft"
}
