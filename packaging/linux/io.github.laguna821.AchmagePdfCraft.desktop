[Desktop Entry]
Type=Application
Name=Achmage PDFCraft
GenericName=PDF Editor
Comment=Read, organize, combine, split and secure PDFs
Exec=pdfcraft %U
TryExec=pdfcraft
Icon=io.github.laguna821.AchmagePdfCraft
Terminal=false
StartupNotify=true
StartupWMClass=io.github.laguna821.AchmagePdfCraft
Categories=Office;Viewer;
Keywords=pdf;viewer;editor;annotate;sign;forms;merge;split;
MimeType=application/pdf;
